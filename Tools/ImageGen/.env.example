# Copy to .env and fill in your own image API credential locally.
export OPENAI_API_KEY=
# For an explicitly selected OpenAI-compatible provider, set its documented URL.
# export OPENAI_BASE_URL=https://api.openai.com/v1

export IMAGEGEN_MODEL=gpt-image-2
export IMAGEGEN_QUALITY=low
export IMAGEGEN_SIZE=1024x1024
export IMAGEGEN_OUTPUT_FORMAT=png
